# Copy to .env and fill in real values. Never commit .env.

# --- Search (Athena) ---
TAVILY_API_KEY=your-tavily-key
SERPER_API_KEY=your-serper-key

# --- LLM (Apollo planning, Hermes review) ---
# LLM_PROVIDER: "groq" or "gemini"
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Loop control (enforced in code) ---
MAX_ROUNDS=2
TIMEOUT_SECONDS=180
SEARCH_MAX_RETRIES=2
LLM_MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=15
VERIFY_MODEL=openai/gpt-oss-20b
# Fallback chain for planning, review and writing (default: LLM_PROVIDER's model first, then the others)
# LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.1-flash-lite
# Claim-verification fallback chain, provider:model in order (each has its own daily quota)
VERIFY_CHAIN=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,gemini:gemini-3.1-flash-lite

# Optional: USD per 1M tokens, only to show an estimated cost on the Cost & Execution page
PRICE_GROQ_INPUT_PER_M=
PRICE_GROQ_OUTPUT_PER_M=
PRICE_GEMINI_INPUT_PER_M=
PRICE_GEMINI_OUTPUT_PER_M=

# --- Accounts (web app login) ---
# Long random string that signs session tokens, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_TTL_HOURS=12
# AUTH_DB=output/users.db
# COOKIE_SECURE=false   # set true when the app is served over HTTPS

# --- Database ---
# Neon / Postgres connection string (users and saved runs). Leave empty to use a local SQLite file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
